#!name=酷狗概念版VIP
#!desc=修复酷狗概念版解锁VIP功能，自动签到领取畅听vip，支持去广告，在线听歌及下载支持hi-res、无损音质，VIP头像挂件，感谢灰佬技术支持，每日凌晨0点10分自动领取VIP，第一使用打开酷狗概念版天天签到领VIP页面或浏览器登陆https://activity.kugou.com/getvips/v-4163b2d0/index.html?should_append_gdt_ua=1获取参数，提示获取成功即可
#!author=3kkk
#!homepage=https://github.com/isoooook/script
#!icon=https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1075.png
#!tag=酷狗概念版

[Argument]
inputCron=input, "10 0 * * *", tag=定时参数
CaptureCookie=switch, false, tag=酷狗数据, desc = 此开关控制插件是否捕获数据
CaptureRemoveAds=switch, true, tag=酷狗去广告, desc = 此开关控制插件是否去广告
CaptureDownMusic=switch, false, tag=酷狗音乐下载, desc = 此开关控制插件是否下载音乐

[Script]
# 定时任务
cron ${inputCron} then script("https://gist.githubusercontent.com/Alex0510/8b958bcf53ed1271e03bb5130b2206ec/raw/kugou_vip.js") with tag="酷狗领取VIP"
# 酷狗数据
request if ${url} ~= /https:\/\/(gateway|gatewayretry|gateway3).kugou.com\/youth\/v1\/activity\/get_month_vip_record.*/i then script("https://gist.githubusercontent.com/Alex0510/8b958bcf53ed1271e03bb5130b2206ec/raw/kugou_cookie.js") with enable=${CaptureCookie}, tag="酷狗数据" 
# 酷狗去广告
response if ${url} ~= /(https?:\/\/)?.*\.kugou\.com\/((v1\/(get_union_vip|vipuser_sub|get_res_privilege)|mobile\/vipinfo|kugouvip\/v[12]\/batch_union_vipinfo)|pendant\/v2\/(set_user_pendan|get_pendant_list)).*/i then script("https://gist.githubusercontent.com/Alex0510/8b958bcf53ed1271e03bb5130b2206ec/raw/kugou_ad.js") with enable=${CaptureRemoveAds}, tag="酷狗去广告", requires_body=true 
# 酷狗音乐下载
response if ${url} ~= /https:\/\/gateway.kugou.com\/tracker\/v5\/url\?album_audio_id/i then script("https://gist.githubusercontent.com/Alex0510/8b958bcf53ed1271e03bb5130b2206ec/raw/mediadownload.js") with enable=${CaptureDownMusic}, tag="音乐下载", requires_body=true 


[MITM]
hostname = *.kugou.com
