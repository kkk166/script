#!name=阿里云盘签到
#!desc=阿里云盘定时签到
#!author=插件作者
#!homepage=插件的主页
#!icon=https://raw.githubusercontent.com/deezertidal/private/main/icons/aliyun.png
#!tag=签到

[Argument]
CaptureCookie=switch, false, true, tag=捕获Cookie, desc = 此开关控制插件是否捕获Cookie
inputCron=input, "6 19 * * *", tag=定时参数

[Script]
response if ${url} ~= /https:\/\/auth.(aliyundrive|alipan).com\/v2\/account\/token/i then script("https://raw.githubusercontent.com/lowking/Scripts/master/ali/aliYunPanCheckIn.js") with enable=${CaptureCookie}, tag="捕获Cookie", timeout=60, requires_body=true 
cron ${inputCron} then script("https://raw.githubusercontent.com/lowking/Scripts/master/ali/aliYunPanCheckIn.js") with tag="阿里云盘签到", timeout=300

[MITM]
hostname = auth.aliyundrive.com, auth.alipan.com
