#!name = WeTalk
#!desc = 签到 + 视频奖励
#!date = 2026-4-16
#!author = 怎么肥事[https://t.me/Nzmgs]
#!icon = https://raw.githubusercontent.com/kkk166/script/refs/heads/main/icon/WeTalk.png
#!loon_version = 3.2.4(787)

[Argument]
arg1 = input, "20 8,20 * * *", tag=定时参数
arg2 = switch, flag, tag=获取Token, desc = 此开关控制插件是否捕获数据


[Script]
cron {arg1} script-path=https://raw.githubusercontent.com/kkk166/script/refs/heads/main/Loon/js/WeTalk.js, timeout=120, tag=WeTalk签到任务
http-request ^https:\/\/api\.wetalkapp\.com\/app\/queryBalanceAndBonus script-path=https://raw.githubusercontent.com/kkk166/script/refs/heads/main/Loon/js/WeTalk.js, timeout=300, enable = {arg2}, tag=获取Token

[MITM]
hostname = api.wetalkapp.com
