#!name=wps签到
#!desc= 打开「WPS」APP → 进任意活动页(任务中心/福利中心)→ 自动触发 page_info,抓 wps_sid，cron 10 点触发,抢完限量爆款顺手做签到等其余任务,逐个串行、动作间随机间隔
#!author=MaYIHEI
#!homepage=https://github.com/MaYIHEI/paperclip
#!icon=https://s21.ax1x.com/2024/11/14/pAgrz6S.png
# https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png
#!loon_version=最低Loon版本: 3.2.4(787)
#!tag=签到

[Argument]
CaptureCookie=switch, false, true, tag=捕获Cookie, desc = 此开关控制插件是否捕获Cookie
CaptureCron=switch, true, false, tag=定时任务, desc = 此开关控制插件是否开启定时任务
inputCron=input, "0 10 * * *", tag=定时参数

[Script]
# 捕获Cookie
http-request ^https:\/\/personal-act\.wps\.cn\/activity-rubik\/activity\/page_info script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.cookie.js, tag=WPS Cookie, timeout=60, requires-body=false, enable = {CaptureCookie}
# 定时任务
cron {inputCron} script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.js, timeout=120, tag=WPS签到, enable = {CaptureCron}

[MITM]
hostname = personal-act.wps.cn
