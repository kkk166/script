#!name = 自动加入TestFlight
#!desc = 自动监控TestFlight名额，一旦有新的名额即刻加入。
#!openUrl = 
#!author = DecoAri xream
#!homepage = https://gitlab.com/lodepuly/vpn_tool/-/tree/master/Tool/Loon/Plugin
#!icon = https://gitlab.com/lodepuly/iconlibrary/-/raw/main/App_icon/120px/TestFlight.png
#!input = APP_ID
#!date = 2024-03-07 22:10:30

[Rule]
DOMAIN, testflight.apple.com, PROXY

[Script]
request if ${url} ~= /^https?:\/\/testflight\.apple\.com\/v3\/accounts\/.*\/apps$/i then script("https://gitlab.com/lodepuly/vpn_tool/-/raw/master/Resource/Script/TestFlight/TF_keys.js") with tag="TF信息获取"
request if ${url} ~= /^https:\/\/testflight.apple.com\/join\/(.*)/i then script("https://gitlab.com/lodepuly/vpn_tool/-/raw/master/Resource/Script/TestFlight/TF_keys.js") with tag="APP_ID获取"
cron "*/60 * * * * *" then script("https://gitlab.com/lodepuly/vpn_tool/-/raw/master/Resource/Script/TestFlight/Auto_join_TF.js") with tag="自动加入TF", timeout=180

[Mitm]
hostname = testflight.apple.com
