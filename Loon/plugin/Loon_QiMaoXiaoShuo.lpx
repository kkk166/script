#!name=七猫小说去广告
#!desc=七猫小说伪装VIP去广告（版本7.25.20）
#!icon=https://gitlab.com/lodepuly/iconlibrary/-/raw/main/App_icon/120px/SevenCat.png
#!tag=小组件

[Rewrite]
request if ${url} ~= /^https:\/\/api-gw\.wtzw\.com\/welf\/app\/v1\/task\/red-packet$/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/(api-\w+|xiaoshuo)\.wtzw\.com\/api\/v\d\//i then script("https://raw.githubusercontent.com/wf021325/qx/master/js/qimao.js") with tag="qimao", timeout=60, requires_body=true

[MITM]
hostname = *.wtzw.com
